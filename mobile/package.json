{
  "name": "@curio-garden/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "APP_VARIANT=development expo start --dev-client",
    "preios": "npm run native:patch:apply",
    "ios": "APP_VARIANT=development expo run:ios",
    "preandroid": "npm run native:patch:apply",
    "android": "APP_VARIANT=development expo run:android",
    "native:patch:apply": "node scripts/apply-expo-audio-background-safety.mjs --apply",
    "native:patch:check": "node scripts/apply-expo-audio-background-safety.mjs --check",
    "eas-build-post-install": "npm run native:patch:apply",
    "lint": "eslint app src plugins scripts app.config.ts",
    "typecheck": "node scripts/run-typescript.mjs --noEmit",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "bundle:check": "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Y2kuY3VyaW9nYXJkZW4uaW52YWxpZCQ expo export --platform all --output-dir dist/ci",
    "dependencies:check": "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Y2kuY3VyaW9nYXJkZW4uaW52YWxpZCQ expo install --check",
    "runtime:check": "node scripts/assert-single-runtime.mjs",
    "doctor": "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Y2kuY3VyaW9nYXJkZW4uaW52YWxpZCQ expo-doctor",
    "check": "npm-run-all native:patch:check lint typecheck test:ci bundle:check dependencies:check runtime:check doctor"
  },
  "dependencies": {
    "@clerk/expo": "^4.5.2",
    "@curio-garden/domain": "*",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "convex": "^1.40.0",
    "expo": "~57.0.15",
    "expo-audio": "~57.0.4",
    "expo-auth-session": "~57.0.8",
    "expo-build-properties": "~57.0.13",
    "expo-constants": "~57.0.12",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.14",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.8",
    "react-native": "0.87.0",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-worklets": "0.12.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^10.7.0",
    "eslint-config-expo": "~57.0.1",
    "expo-doctor": "1.20.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "npm-run-all": "^4.1.5",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-audio"
        ]
      },
      "ios": {
        "buildFromSource": [
          "expo-audio"
        ]
      }
    },
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "react-test-renderer"
      ]
    }
  }
}
