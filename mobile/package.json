{
  "name": "@curio-garden/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "APP_VARIANT=development expo start --dev-client",
    "ios": "APP_VARIANT=development expo run:ios",
    "android": "APP_VARIANT=development expo run:android",
    "lint": "eslint app src app.config.ts",
    "typecheck": "node scripts/run-typescript.mjs --noEmit",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "bundle:check": "expo export --platform all --output-dir dist/ci",
    "dependencies:check": "expo install --check",
    "runtime:check": "node scripts/assert-single-runtime.mjs",
    "doctor": "npx --yes expo-doctor@1.20.1",
    "check": "npm-run-all lint typecheck test:ci bundle:check dependencies:check runtime:check"
  },
  "dependencies": {
    "expo": "~57.0.10",
    "expo-build-properties": "~57.0.8",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.10",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^10.7.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "npm-run-all": "^4.1.5",
    "react-test-renderer": "19.2.8",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "react-test-renderer"
      ]
    }
  }
}
