+private sealed class LockScreenPlayback {
+  abstract val source: BaseAudioPlayer
+  abstract val metadata: Metadata?
+  abstract var isActive: Boolean
+  abstract var mediaSession: MediaSession
+  abstract val isLive: Boolean
+  abstract val supportsTrackNavigation: Boolean
+
+  val ref: ExoPlayer
+    get() = source.ref
+
+  abstract fun requestPlayback()
+  abstract fun cancelPlayback()
+  abstract fun assignBasicMediaSession()
+
+  fun matches(candidate: BaseAudioPlayer?): Boolean = source === candidate
+
+  class Player(private val player: AudioPlayer) : LockScreenPlayback() {
+    override val source: BaseAudioPlayer get() = player
+    override val metadata: Metadata? get() = player.metadata
+    override var isActive: Boolean
+      get() = player.isActiveForLockScreen
+      set(value) { player.isActiveForLockScreen = value }
+    override var mediaSession: MediaSession
+      get() = player.mediaSession
+      set(value) { player.mediaSession = value }
+    override val isLive: Boolean get() = player.isLive
+    override val supportsTrackNavigation = false
+    override fun requestPlayback() = player.requestPlaybackFromSystemControls()
+    override fun cancelPlayback() = player.cancelPlaybackFromSystemControls()
+    override fun assignBasicMediaSession() = player.assignBasicMediaSession()
+  }
+
+  class Playlist(private val playlist: AudioPlaylist) : LockScreenPlayback() {
+    override val source: BaseAudioPlayer get() = playlist
+    override val metadata: Metadata? get() = playlist.currentMetadata
+    override var isActive: Boolean
+      get() = playlist.isActiveForLockScreen
+      set(value) { playlist.isActiveForLockScreen = value }
+    override var mediaSession: MediaSession
+      get() = playlist.mediaSession
+      set(value) { playlist.mediaSession = value }
+    override val isLive = false
+    override val supportsTrackNavigation = true
+    override fun requestPlayback() = playlist.requestPlaybackFromSystemControls()
+    override fun cancelPlayback() = playlist.cancelPlaybackFromSystemControls()
+    override fun assignBasicMediaSession() = playlist.assignBasicMediaSession()
+  }
+}
