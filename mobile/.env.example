# Curio Garden native public configuration
# Copy this file to mobile/.env.local for local development. Expo commands run
# with mobile/ as their project root, so the repository-root .env.local is not
# loaded automatically.

# Required. Use the same Clerk development-instance publishable key as the web
# app. This value is bundled into the native client and must begin with pk_test_.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional for development and E2E, which default to the reviewed public
# development deployment. Preview and Production must set an explicit value in
# their corresponding EAS environments instead of relying on a checked-in file.
# EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Optional only for local Development/E2E tooling, which defaults to the local
# web server. Every cloud non-production build requires an explicit reviewed
# PR-preview HTTPS origin. Production is pinned to https://curiogarden.org.
# Android Emulator may use http://10.0.2.2:3000 for local Development/E2E only.
# EXPO_PUBLIC_WEB_ORIGIN=http://127.0.0.1:3000
