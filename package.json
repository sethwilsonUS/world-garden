{
  "name": "curio-garden",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "mobile",
    "packages/*"
  ],
  "engines": {
    "node": "^24.3.0"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:python": "npm-run-all --parallel dev:frontend-python dev:backend dev:tts-python",
    "dev:frontend": "next dev --webpack",
    "dev:frontend-python": "USE_PYTHON_TTS=true next dev --webpack",
    "dev:backend": "convex dev",
    "dev:tts-python": "bash scripts/ensure-edge-tts.sh scripts/dev-tts.py",
    "local": "LOCAL_MODE=true NEXT_PUBLIC_LOCAL_MODE=true next dev --webpack",
    "analytics:site": "node scripts/site-analytics-report.mjs",
    "report:costs": "node scripts/ai-cost-report.mjs",
    "report:feedback": "node scripts/product-feedback-report.mjs",
    "analytics:costs": "node scripts/ai-cost-report.mjs",
    "feedback": "node scripts/product-feedback-report.mjs",
    "audit:mediawiki": "tsx scripts/mediawiki-corpus-audit.ts",
    "eval:trending-podcast": "tsx scripts/trending-brief-eval.ts",
    "render:trending-podcast-eval": "tsx scripts/render-trending-brief-eval-audio.ts",
    "arch": "ts-archunit check",
    "arch:baseline": "ts-archunit baseline --output arch-baseline.json",
    "arch:explain": "ts-archunit explain --format agent",
    "build": "bash scripts/build.sh",
    "start": "next start",
    "lint": "npm-run-all lint:eslint lint:anti-slop",
    "lint:eslint": "eslint",
    "lint:anti-slop": "npm-run-all lint:anti-slop:verify lint:anti-slop:root",
    "lint:anti-slop:verify": "node scripts/verify-anti-slop.mjs",
    "lint:anti-slop:root": "node node_modules/oxlint/bin/oxlint --config .oxlintrc.json --disable-nested-config --ignore-pattern 'mobile/**' --ignore-pattern 'tools/oxlint/canary.ts' .",
    "lint:anti-slop:mobile": "npm-run-all lint:anti-slop:verify lint:anti-slop:mobile:project",
    "lint:anti-slop:mobile:project": "node node_modules/oxlint/bin/oxlint --config .oxlintrc.json --disable-nested-config mobile/app mobile/src mobile/plugins mobile/scripts mobile/app.config.ts mobile/arch.rules.mts",
    "toolchain:check": "node scripts/validate-toolchain.mjs",
    "typecheck": "npm-run-all typecheck:native typecheck:tooling typecheck:domain",
    "typecheck:native": "tsc --noEmit",
    "typecheck:tooling": "node node_modules/typescript/bin/tsc --noEmit",
    "typecheck:domain": "node node_modules/typescript/bin/tsc --noEmit -p packages/domain/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts",
    "docs:check": "node scripts/validate-doc-links.mjs",
    "mobile:start": "npm run start --workspace @curio-garden/mobile",
    "mobile:ios": "npm run ios --workspace @curio-garden/mobile",
    "mobile:android": "npm run android --workspace @curio-garden/mobile",
    "mobile:check": "npm run check --workspace @curio-garden/mobile",
    "mobile:doctor": "npm run doctor --workspace @curio-garden/mobile",
    "check": "npm-run-all toolchain:check lint typecheck arch test"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.4.3",
    "@curio-garden/domain": "*",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "convex": "^1.40.0",
    "echarts": "^6.1.0",
    "maplibre-gl": "^6.4.1",
    "next": "^16.2.7",
    "openai": "^6.46.0",
    "parse5": "^8.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@clerk/testing": "^2.2.16",
    "@eslint/compat": "^2.1.0",
    "@nielspeter/ts-archunit": "0.61.0",
    "@oxlint/plugins": "1.80.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.7.0",
    "eslint-config-next": "^16.2.7",
    "eslint-import-resolver-typescript": "3.10.1",
    "expo-modules-core": "57.0.14",
    "fast-check": "^4.3.0",
    "github-slugger": "^2.0.0",
    "jsdom": "^29.1.1",
    "npm-run-all": "^4.1.5",
    "oxlint": "1.80.0",
    "playwright": "^1.61.1",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "react-native-gesture-handler": "$react-native-gesture-handler",
    "react-native-reanimated": "$react-native-reanimated",
    "react-native-safe-area-context": "$react-native-safe-area-context",
    "react-native-screens": "$react-native-screens",
    "react-native-worklets": "$react-native-worklets"
  }
}
